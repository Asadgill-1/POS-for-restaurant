# ── Database ────────────────────────────────────────────────────────────────
# Local dev: `pnpm db:local` (no Docker) or `docker compose up -d`.
# Vercel:    provisioned by the Neon marketplace integration.
#
# TWO DIFFERENT ROLES, and it matters (docs/DECISIONS.md §4a): row level
# security is silently ignored for a superuser or BYPASSRLS role.
#
# Runtime queries — the least-privilege role. Never the owner, never a superuser.
#   local: postgresql://mizan_app:mizan_local_dev@127.0.0.1:5433/mizan_pos
DATABASE_URL=
# Migrations only (`prisma migrate deploy` via directUrl) — the owning role.
#   local: postgresql://mizan:mizan_local_dev@127.0.0.1:5433/mizan_pos
DATABASE_URL_UNPOOLED=

# ── Auth (M1) ───────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# ── Storage (M4 — product images, logos) ────────────────────────────────────
BLOB_READ_WRITE_TOKEN=

# ── Runtime ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Not needed until the milestone that introduces them ─────────────────────
# STRIPE_SECRET_KEY=          # M14 — SaaS subscription billing
# STRIPE_WEBHOOK_SECRET=      # M14
# RESEND_API_KEY=             # M6  — emailed receipts
# SENTRY_DSN=                 # M15
