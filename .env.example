# ── Database ────────────────────────────────────────────────────────────────
# Local dev: docker compose up -d  (see docker-compose.yml)
# Vercel:    provisioned automatically by the Neon marketplace integration.
DATABASE_URL=
# Direct (unpooled) connection. Required by `prisma migrate` and by any
# session-level Postgres feature. Neon injects this alongside DATABASE_URL.
DATABASE_URL_UNPOOLED=

# ── Auth (M1) ───────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# ── Storage (M4 — product images, logos) ────────────────────────────────────
BLOB_READ_WRITE_TOKEN=

# ── Runtime ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Not needed until the milestone that introduces them ─────────────────────
# STRIPE_SECRET_KEY=          # M14 — SaaS subscription billing
# STRIPE_WEBHOOK_SECRET=      # M14
# RESEND_API_KEY=             # M6  — emailed receipts
# SENTRY_DSN=                 # M15
